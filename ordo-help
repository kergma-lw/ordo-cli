#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
VENV_PYTHON="$ROOT_DIR/.venv/bin/python"
HELP_MODULE_PATH="$ROOT_DIR/src/ordo/help_cli.py"
PYTHONPATH_VALUE="$ROOT_DIR/src:$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"

if [[ ! -x "$VENV_PYTHON" ]]; then
  printf 'Missing project virtualenv interpreter: %s\n' "$VENV_PYTHON" >&2
  printf 'Create the project virtualenv and install Ordo first.\n' >&2
  exit 1
fi

if [[ ! -f "$HELP_MODULE_PATH" ]]; then
  printf 'Missing ordo-help CLI module: %s\n' "$HELP_MODULE_PATH" >&2
  printf 'Implement the ordo-help Python entrypoint before using this launcher.\n' >&2
  exit 1
fi

exec env PYTHONPATH="$PYTHONPATH_VALUE" "$VENV_PYTHON" -m ordo.help_cli "$@"

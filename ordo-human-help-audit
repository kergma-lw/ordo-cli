#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(CDPATH='' cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink -- "$SOURCE")"
  if [[ "$SOURCE" != /* ]]; then
    SOURCE="$DIR/$SOURCE"
  fi
done

ROOT_DIR="$(CDPATH='' cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
VENV_PYTHON="$ROOT_DIR/.venv/bin/python"
AUDIT_MODULE_PATH="$ROOT_DIR/src/ordo/human_help_audit.py"
PYTHONPATH_VALUE="$ROOT_DIR/src:$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"

if [[ ! -x "$VENV_PYTHON" ]]; then
  printf 'Missing project virtualenv interpreter: %s\n' "$VENV_PYTHON" >&2
  printf 'Create the project virtualenv and install Ordo first.\n' >&2
  exit 1
fi

if [[ ! -f "$AUDIT_MODULE_PATH" ]]; then
  printf 'Missing human-help audit module: %s\n' "$AUDIT_MODULE_PATH" >&2
  exit 1
fi

exec env PYTHONPATH="$PYTHONPATH_VALUE" "$VENV_PYTHON" -m ordo.human_help_audit "$@"
